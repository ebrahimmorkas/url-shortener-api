NODE_ENV=development
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*
# Public origin used to build short links, e.g. https://sho.rt
BASE_URL=http://localhost:3002

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortener

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# Redis (optional). Enables: shared redirect cache, distributed rate limiting
# and a BullMQ click-ingestion queue. Without it: in-memory LRU cache, local
# rate limits and an in-process batching click buffer.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Redirect cache TTL and click ingestion batching
REDIRECT_CACHE_TTL_SECONDS=300
CLICK_FLUSH_INTERVAL_MS=1000
CLICK_BATCH_SIZE=500

# Rate limiting (per IP, per minute)
RATE_LIMIT_MAX=120
